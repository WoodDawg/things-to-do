# Neon pooled connection string (postgresql://...@...-pooler.../neondb?sslmode=require)
DATABASE_URL=

# 32+ random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# bcrypt hash of your password. Generate with: npm run hash-password -- 'your-password'
# In .env files every $ must be escaped as \$ (Next expands $VAR otherwise) —
# the script prints the line pre-escaped, just paste it.
APP_PASSWORD_HASH=

# Home coordinates for distance sorting/filtering (decimal degrees)
HOME_LAT=
HOME_LNG=

# Two-letter state the add-place form defaults to, e.g. MD
HOME_STATE=

# Identifying User-Agent for Nominatim, e.g. things-to-do-app/1.0 (contact: you@example.com)
GEOCODER_USER_AGENT=
